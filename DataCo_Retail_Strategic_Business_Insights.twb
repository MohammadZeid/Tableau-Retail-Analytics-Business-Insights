      <aliases enabled='yes' />
      <column caption='Total Orders' datatype='integer' name='[Calculation_0014483889242248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order Id])' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_0014483889369225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales per customer]) &lt;&gt; 0 THEN&#10;    SUM([Order Profit Per Order]) / SUM([Sales per customer])&#10;END' />
      </column>
      <column caption='Order Month' datatype='datetime' name='[Calculation_0014483889455242]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order date (DateOrders)])' />
      </column>
      <column caption='Late Delivery Rate' datatype='real' name='[Calculation_0014483889578123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Late_delivery_risk] = 1 THEN [Order Id] END&#10;)&#10;/&#10;COUNTD([Order Id])' />
      </column>
      <column caption='Shipping Delay Days' datatype='integer' name='[Calculation_0014483889655948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Days for shipping (real)]&#10;-&#10;[Days for shipment (scheduled)]' />
      </column>
      <column caption='Top N Product Filter' datatype='boolean' name='[Calculation_0014483901857956]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_DENSE(&#10;    SUM([Sales per customer]),&#10;    &apos;desc&apos;&#10;)&#10;&lt;= [Parameters].[Parameter 0014483901608099]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Loss Making Product' datatype='boolean' name='[Calculation_0014483903676582]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Order Profit Per Order]) &lt; 0' />
      </column>
