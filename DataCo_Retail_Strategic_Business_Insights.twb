    <dashboard name='Regional and Operational Risk' type='storyboard'>
      <repository-location id='RegionalandOperationalRisk' path='/workbooks/DataCo_Retail_Strategic_Business_Insights' revision='' />
      <layout-options>
        <title>
          <formatted-text>
            <run>Regional and Operational Risk</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='678' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='3527' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone fixed-size='151' h='15664' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4357' />
            <zone h='79149' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='20021'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Regional analysis reveals substantial differences in sales and profitability across markets and customer segments, while the geographic view highlights where performance is concentrated. Operational analysis also shows that late-delivery risk varies considerably by shipping mode, with expedited shipping showing weaker delivery performance than Standard Class. These results help management identify regional profitability risks and shipping-process weaknesses that may require targeted operational improvements.' captured-sheet='Regional &amp; Operational Insights' id='1' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{1148B2DD-3B7D-45CA-9D5B-C407B59B184E}' />
    </dashboard>
    <dashboard name='Retail Strategic Business Insights Story' type='storyboard'>
      <repository-location id='RetailStrategicBusinessInsightsStory' path='/workbooks/DataCo_Retail_Strategic_Business_Insights' revision='' />
      <layout-options>
        <title>
          <formatted-text>
            <run>Retail Analytics Business Challenge</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='748' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='3527' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone fixed-size='114' h='11826' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4357' />
            <zone h='82987' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='16183'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Senior management requires a consolidated view of sales, profitability, customer value, product performance, regional trends and operational risk. This Executive Overview establishes the business context by presenting core KPIs, category performance and monthly sales trends as the starting point for deeper analysis.' captured-sheet='Executive Overview' id='1' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{D7CB256C-5182-4C9F-A1D9-FD3205142FEC}' />
    </dashboard>
    <dashboard name='Strategic Implications and Recommendations' type='storyboard'>
      <repository-location id='StrategicImplicationsandRecommendations' path='/workbooks/DataCo_Retail_Strategic_Business_Insights' revision='' />
      <layout-options>
        <title>
          <formatted-text>
            <run>Strategic Implications and Recommendations</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='716' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='3527' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone fixed-size='160' h='16598' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4357' />
            <zone h='78215' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='20955'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='The analysis indicates that management should protect high-performing customer and product segments while addressing loss-making products and regional profitability gaps. Pricing, discounting and product-mix decisions should be reviewed for weak products, while operational attention should focus on the high late-delivery rate associated with expedited shipping. Tableau dashboards support these actions by allowing managers to monitor sales, profit, customer segments, geographic performance and delivery risk interactively, enabling faster and more evidence-based retail decisions.' captured-sheet='Regional &amp; Operational Insights' id='1' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{74A0B046-9905-47BF-BC75-EE1527074606}' />
    </dashboard>
    <dashboard name='Weak Products and Profitability Risk' type='storyboard'>
      <repository-location id='WeakProductsandProfitabilityRisk' path='/workbooks/DataCo_Retail_Strategic_Business_Insights' revision='' />
      <layout-options>
        <title>
          <formatted-text>
            <run>Weak Products and Profitability Risk</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='701' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='3527' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone fixed-size='141' h='14627' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4357' />
            <zone h='80186' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='18984'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='The product analysis identifies a small group of loss-making products, with SOLE E35 Elliptical showing the largest negative profit, followed by Bushnell Pro X7 Jolt Slope and SOLE E25 Elliptical. The sales–profit relationship also helps distinguish products that generate revenue without comparable profitability. These findings highlight where pricing, discounting, product mix, or inventory decisions may require management attention.' captured-sheet='Customer &amp; Product Performance' id='1' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{003C75E3-C426-432A-AA72-32DA22754E47}' />
    </dashboard>
